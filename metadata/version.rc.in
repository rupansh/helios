1 VERSIONINFO
FILEVERSION @COMMA@
PRODUCTVERSION @COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x00040004L
FILETYPE @FILE_TYPE@
FILESUBTYPE @SUBTYPE@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@PUBLISHER@\0"
            VALUE "FileDescription", "@DESCRIPTION@\0"
            VALUE "FileVersion", "@DOTTED@\0"
            VALUE "InternalName", "@INTERNAL@\0"
            VALUE "OriginalFilename", "@FILENAME@\0"
            VALUE "ProductName", "@PRODUCT@\0"
            VALUE "ProductVersion", "@DOTTED@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
