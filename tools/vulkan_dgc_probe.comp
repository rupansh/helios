#version 450
layout(local_size_x = 1) in;
layout(constant_id = 0) const uint tag = 1;
layout(set = 0, binding = 0, std430) buffer Output { uint words[]; } output_data;
layout(push_constant) uniform Root { uint index; uint untouched; } root;
void main()
{
    output_data.words[root.index] = tag * 100 + root.untouched;
}
